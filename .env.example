# Copy to .env and fill in production values. Never commit a filled .env.

APP_ENV=development
PORT=8080
DATABASE_PATH=./data/app.db

# Required in production (APP_ENV=production). At least 32 characters.
JWT_SECRET=dev-secret-change-me

# Required in production. Distinct from JWT_SECRET, at least 32 characters.
MAIL_UNSUB_SECRET=

# First production admin password (upper + lower + digit, not a seed password).
BOOTSTRAP_ADMIN_PASSWORD=

# Optional. Protects GET /metrics. If unset in production, localhost only.
METRICS_TOKEN=

# Optional comma-separated CIDRs/IPs trusted for X-Forwarded-For.
TRUSTED_PROXIES=

# Days to keep api/op/login logs. Default 30. Set 0 to disable purge.
LOG_RETENTION_DAYS=30

# Sample 1 of N API log writes. Default 1 in development, 5 in production.
API_LOG_SAMPLE=

# Seconds. Auth user cache. Default 30.
SESSION_CACHE_TTL=30s

CORS_ORIGIN=http://localhost:5173,http://localhost:5174
